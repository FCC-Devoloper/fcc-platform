      "html_code": "<!DOCTYPE html>\n<html lang=\"ru\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>2 OCTA EDITS – Cinematic Intro</title>\n  <script src=\"https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js\"></script>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    body {\n      width: 100vw;\n      height: 100vh;\n      overflow: hidden;\n      background: #05050a;\n      font-family: 'Segoe UI', system-ui, sans-serif;\n      perspective: 1600px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      user-select: none;\n    }\n\n    body::before {\n      content: '';\n      position: fixed;\n      inset: 0;\n      background:\n        radial-gradient(ellipse at 30% 20%, rgba(30,40,90,0.22) 0%, transparent 50%),\n        radial-gradient(ellipse at 70% 80%, rgba(20,30,70,0.18) 0%, transparent 50%),\n        radial-gradient(ellipse at center, transparent 20%, rgba(0,0,0,0.88) 100%);\n      pointer-events: none;\n      z-index: 90;\n    }\n\n    #stars-canvas {\n      position: fixed;\n      inset: 0;\n      width: 100%;\n      height: 100%;\n      z-index: 1;\n      pointer-events: none;\n    }\n\n    #stage {\n      position: relative;\n      width: 100%;\n      height: 100%;\n      transform-style: preserve-3d;\n      z-index: 10;\n    }\n\n    /* ===== КАРТЫ ===== */\n    .card {\n      position: absolute;\n      width: 250px;\n      height: 355px;\n      left: 50%;\n      top: 50%;\n      margin-left: -125px;\n      margin-top: -177px;\n      transform-style: preserve-3d;\n      border-radius: 18px;\n      box-shadow:\n        0 25px 50px -12px rgba(0,0,0,0.9),\n        0 0 0 1px rgba(255,255,255,0.07);\n      will-change: transform;\n    }\n\n    .card-face {\n      position: absolute;\n      width: 100%;\n      height: 100%;\n      backface-visibility: hidden;\n      border-radius: 18px;\n      overflow: hidden;\n    }\n\n    .card-back {\n      background: linear-gradient(160deg, #1c1c2e 0%, #12121c 50%, #0b0b14 100%);\n      border: 1px solid rgba(255,255,255,0.08);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .card-back::before {\n      content: '';\n      position: absolute;\n      inset: 12px;\n      border: 1px solid rgba(255,255,255,0.05);\n      border-radius: 12px;\n    }\n    .card-back::after {\n      content: '◆';\n      font-size: 44px;\n      color: rgba(255,255,255,0.09);\n      letter-spacing: 8px;\n    }\n\n    /* Чистый chroma-key зелёный */\n    .card-front {\n      background: #00FF00;\n      transform: rotateY(180deg);\n      position: relative;\n    }\n\n    .corner-text {\n      position: absolute;\n      font-size: 12px;\n      font-weight: 700;\n      letter-spacing: 1.4px;\n      color: rgba(0,0,0,0.82);\n      text-transform: uppercase;\n      white-space: nowrap;\n      z-index: 5;\n    }\n    .corner-text.top-left { top: 14px; left: 14px; }\n    .corner-text.bottom-right {\n      bottom: 14px;\n      right: 14px;\n      transform: rotate(180deg);\n    }\n\n    /* ===== КИБЕРПАНК ЛОГОТИП ===== */\n    #final-text {\n      position: absolute;\n      left: 50%;\n      top: 48%;\n      transform: translate(-50%, -50%) rotateX(12deg);\n      font-size: clamp(32px, 8vw, 92px);\n      font-weight: 800;\n      letter-spacing: 0.18em;\n      opacity: 0;\n      z-index: 60;\n      pointer-events: none;\n      white-space: nowrap;\n      transform-style: preserve-3d;\n      will-change: transform, opacity, filter;\n    }\n\n    #final-text .neon {\n      color: #e8e8e8;\n      text-shadow:\n        0 0 4px #ffffff,\n        0 0 12px #00f0ff,\n        0 0 28px #00aaff,\n        0 0 50px rgba(0,180,255,0.5),\n        0 2px 0 #111,\n        0 4px 0 #0a0a0a,\n        0 6px 12px rgba(0,0,0,0.6);\n      filter: drop-shadow(0 0 8px rgba(0,220,255,0.4));\n    }\n\n    #neon-line {\n      position: absolute;\n      left: 50%;\n      top: 58%;\n      height: 2px;\n      width: 0;\n      background: linear-gradient(90deg, transparent, #00f0ff, #ffffff, #00f0ff, transparent);\n      box-shadow:\n        0 0 10px #00f0ff,\n        0 0 25px rgba(0,200,255,0.6);\n      transform: translateX(-50%);\n      opacity: 0;\n      z-index: 59;\n      border-radius: 1px;\n    }\n  </style>\n</head>\n<body>\n  <canvas id=\"stars-canvas\"></canvas>\n\n  <div id=\"stage\">\n    <div class=\"card\" id=\"card-1\">\n      <div class=\"card-face card-back\"></div>\n      <div class=\"card-face card-front\">\n        <span class=\"corner-text top-left\">2 OCTA EDITS</span>\n        <span class=\"corner-text bottom-right\">2 OCTA EDITS</span>\n      </div>\n    </div>\n\n    <div class=\"card\" id=\"card-2\">\n      <div class=\"card-face card-back\"></div>\n      <div class=\"card-face card-front\">\n        <span class=\"corner-text top-left\">2 OCTA EDITS</span>\n        <span class=\"corner-text bottom-right\">2 OCTA EDITS</span>\n      </div>\n    </div>\n\n    <div class=\"card\" id=\"card-3\">\n      <div class=\"card-face card-back\"></div>\n      <div class=\"card-face card-front\">\n        <span class=\"corner-text top-left\">2 OCTA EDITS</span>\n        <span class=\"corner-text bottom-right\">2 OCTA EDITS</span>\n      </div>\n    </div>\n  </div>\n\n  <div id=\"final-text\"><span class=\"neon\">2 OCTA EDITS</span></div>\n  <div id=\"neon-line\"></div>\n\n  <script>\n    const T = {\n      enter:    1.7,\n      flip:     0.9,\n      gather:   0.9,\n      exit:     1.4,\n      textIn:   1.0,\n      textHold: 2.4,\n      textOut:  1.3\n    };\n\n    const c1 = document.getElementById('card-1');\n    const c2 = document.getElementById('card-2');\n    const c3 = document.getElementById('card-3');\n    const cards = [c1, c2, c3];\n    const finalText = document.getElementById('final-text');\n    const neonLine = document.getElementById('neon-line');\n\n    // ===== ЗВЁЗДОЧКИ =====\n    const canvas = document.getElementById('stars-canvas');\n    const ctx = canvas.getContext('2d');\n    let stars = [];\n\n    function resize() {\n      canvas.width = innerWidth;\n      canvas.height = innerHeight;\n    }\n    resize();\n    addEventListener('resize', resize);\n\n    function drawStar(x, y, size, alpha) {\n      ctx.save();\n      ctx.translate(x, y);\n      ctx.beginPath();\n      ctx.moveTo(0, -size);\n      ctx.lineTo(size * 0.28, -size * 0.28);\n      ctx.lineTo(size, 0);\n      ctx.lineTo(size * 0.28, size * 0.28);\n      ctx.lineTo(0, size);\n      ctx.lineTo(-size * 0.28, size * 0.28);\n      ctx.lineTo(-size, 0);\n      ctx.lineTo(-size * 0.28, -size * 0.28);\n      ctx.closePath();\n      ctx.fillStyle = `rgba(180, 220, 255, ${alpha})`;\n      ctx.fill();\n      ctx.restore();\n    }\n\n    for (let i = 0; i < 65; i++) {\n      stars.push({\n        x: Math.random() * innerWidth,\n        y: Math.random() * innerHeight,\n        size: Math.random() * 3.2 + 1.1,\n        speed: Math.random() * 0.6 + 0.18,\n        alpha: Math.random() * 0.5 + 0.25,\n        twinkle: Math.random() * Math.PI * 2\n      });\n    }\n\n    function animateStars() {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      stars.forEach(s => {\n        s.y -= s.speed;\n        s.twinkle += 0.03;\n        if (s.y < -10) {\n          s.y = canvas.height + 10;\n          s.x = Math.random() * canvas.width;\n        }\n        const a = s.alpha * (0.7 + Math.sin(s.twinkle) * 0.3);\n        drawStar(s.x, s.y, s.size, a);\n      });\n      requestAnimationFrame(animateStars);\n    }\n    animateStars();\n\n    // Начальные позиции\n    gsap.set(cards, {\n      x: -1100,\n      y: 0,\n      z: -200,\n      rotationY: 0,\n      rotationX: 8,\n      scale: 0.85,\n      opacity: 0\n    });\n    gsap.set(c1, { y: -120 });\n    gsap.set(c3, { y:  120 });\n    gsap.set(finalText, { opacity: 0, scale: 0.35, filter: 'blur(16px)' });\n    gsap.set(neonLine, { width: 0, opacity: 0 });\n\n    // ===== ТАЙМЛАЙН =====\n    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });\n\n    // 1. Вход слева (карты не пересекаются)\n    tl.to(cards, {\n      x: (i) => [-320, 0, 320][i],\n      opacity: 1,\n      scale: 1,\n      duration: T.enter,\n      stagger: 0.12,\n      ease: 'power4.out'\n    }, 0)\n    .to(c1, { z: -280, rotationY: -20, rotationX: 5, duration: T.enter }, 0)\n    .to(c3, { z: -280, rotationY:  20, rotationX: 5, duration: T.enter }, 0)\n    .to(c2, { z: 90, rotationX: 0, duration: T.enter }, 0);\n\n    // 2. Переворот главной\n    tl.to(c2, {\n      rotationY: 180,\n      duration: T.flip,\n      ease: 'power2.inOut'\n    }, '+=0.25');\n\n    // 3. Сборка — карты стоят рядом, не внутри друг друга\n    tl.to(cards, {\n      x: (i) => [-210, 0, 210][i],   // достаточный отступ\n      y: 0,\n      z: (i) => [-40, 80, -40][i],  // центральная ближе\n      rotationY: (i) => [165, 180, 195][i],\n      rotationX: 0,\n      scale: 0.95,\n      duration: T.gather,\n      ease: 'power2.inOut',\n      stagger: 0.04\n    }, '+=0.2');\n\n    // 4. Уход с явным 3D-поворотом\n    tl.to(cards, {\n      x: 1400,\n      z: -900,\n      y: (i) => [-90, 0, 90][i],\n      scale: 0.32,\n      rotationY: (i) => [220, 250, 280][i],\n      rotationX: -28,\n      rotationZ: (i) => [-12, 0, 12][i],\n      duration: T.exit,\n      ease: 'power3.in',\n      stagger: 0.09\n    }, '+=0.2')\n    .to(cards, {\n      opacity: 0,\n      duration: 0.35\n    }, `-=0.35`);\n\n    // 5. Киберпанк логотип\n    tl.to(finalText, {\n      opacity: 1,\n      scale: 1,\n      filter: 'blur(0px)',\n      duration: T.textIn,\n      ease: 'back.out(1.5)'\n    }, `-=${T.exit * 0.3}`)\n    .to(neonLine, {\n      width: 'min(480px, 78vw)',\n      opacity: 1,\n      duration: 0.85,\n      ease: 'power2.out'\n    }, '<0.3')\n    .to(finalText, {\n      filter: 'drop-shadow(0 0 14px rgba(0,220,255,0.8)) drop-shadow(0 0 30px rgba(0,180,255,0.4))',\n      duration: 0.9,\n      yoyo: true,\n      repeat: 1,\n      ease: 'sine.inOut'\n    }, '<0.2');\n\n    // 6. Выход\n    tl.to({}, { duration: T.textHold })\n    .to(finalText, {\n      opacity: 0,\n      scale: 1.2,\n      filter: 'blur(16px)',\n      y: '+=20',\n      duration: T.textOut,\n      ease: 'power2.in'\n    })\n    .to(neonLine, {\n      width: 0,\n      opacity: 0,\n      duration: T.textOut * 0.7,\n      ease: 'power2.in'\n    }, '<');\n\n    document.body.addEventListener('click', () => location.reload());\n  </script>\n</body>\n</html>",
