      "html_code": "<!DOCTYPE html>\n<html lang=\"tg\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"/>\n  <title>Саҳифаи графики! ✦ Аниматсия</title>\n  <style>\n    * {\n      margin: 0;\n      padding: 0;\n      box-sizing: border-box;\n    }\n\n    body {\n      height: 100vh;\n      background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);\n      color: #fff;\n      font-family: 'Segoe UI', system-ui, sans-serif;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      overflow: hidden;\n    }\n\n    .loader {\n      position: fixed;\n      inset: 0;\n      background: #0f0c29;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      z-index: 9999;\n      transition: opacity 1s ease 3s;\n      opacity: 1;\n      pointer-events: none;\n    }\n\n    .loader.hidden {\n      opacity: 0;\n    }\n\n    .content {\n      text-align: center;\n      opacity: 0;\n      transform: translateY(40px);\n      transition: all 1.2s ease;\n    }\n\n    .content.show {\n      opacity: 1;\n      transform: translateY(0);\n    }\n\n    h1 {\n      font-size: 5.5rem;\n      margin-bottom: 1.5rem;\n      background: linear-gradient(90deg, #00d4ff, #ff00aa, #00ffea);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      background-size: 200% auto;\n      animation: gradient 4s linear infinite;\n    }\n\n    .typing {\n      font-size: 2.2rem;\n      color: #a5d8ff;\n      font-weight: 300;\n      letter-spacing: 2px;\n      overflow: hidden;\n      white-space: nowrap;\n      border-right: 4px solid #00d4ff;\n      width: 0;\n      animation: typing 3.5s steps(18) forwards, blink 0.8s infinite;\n    }\n\n    @keyframes typing {\n      from { width: 0 }\n      to   { width: 100% }\n    }\n\n    @keyframes blink {\n      from, to   { border-color: transparent }\n      50%        { border-color: #00d4ff; }\n    }\n\n    @keyframes gradient {\n      0%   { background-position: 0% 50% }\n      50%  { background-position: 100% 50% }\n      100% { background-position: 0% 50% }\n    }\n\n    @media (max-width: 600px) {\n      h1 { font-size: 3.8rem; }\n      .typing { font-size: 1.6rem; }\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"loader\" id=\"loader\">\n    <!-- Агар хоҳӣ спиннер илова кунӣ, метавонӣ инро гузорӣ -->\n    <!-- <div class=\"spinner\"></div> -->\n  </div >\n\n  <div class=\"content\" id=\"content\">\n    <h1>Салом, Хонандаҳо!</h1>\n    <div class=\"typing\">Хуш омадед ба дарси ман...</div>\n  </div>\n\n  <script>\n    window.addEventListener('load', () => {\n      const loader = document.getElementById('loader');\n      const content = document.getElementById('content');\n\n      // Пас аз 1.0 сония loader-ро пинҳон мекунад\n      setTimeout(() => {\n        loader.classList.add('hidden');\n        setTimeout(() => {\n          content.classList.add('show');\n        }, 400); // каме таъхир барои эффект\n      }, 1500);\n    });\n  </script>\n\n</body>\n</html>",
